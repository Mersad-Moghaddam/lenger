# VHS tape: Lenger Smart Cleanup & Volume Safety
Output docs/vhs/cleanup.gif

Set Shell "bash"
Set FontSize 14
Set Width 1280
Set Height 720
Set Padding 10
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful

Type "lenger --theme omarchy"
Enter
Sleep 2s

# Navigate to System DF
Type "7"
Sleep 2s

# Open Smart Cleanup Preview
Type "c"
Sleep 2s

# Navigate cleanup categories
Down 1
Sleep 1s
Space
Sleep 1s
Down 1
Sleep 1s
Space
Sleep 1s

# Proceed to confirmation modal
Enter
Sleep 2s

# Cancel safely
Type "q"
Sleep 1s

Type "q"
Sleep 1s
