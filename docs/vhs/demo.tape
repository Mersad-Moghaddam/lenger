# VHS tape: Lenger General Walk-through
Output docs/vhs/demo.gif

Set Shell "bash"
Set FontSize 14
Set Width 1280
Set Height 720
Set Padding 10
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful

Type "lenger --theme omarchy"
Enter
Sleep 2s

# Tab 1: Harbor Dashboard
Sleep 1.5s

# Tab 2: Images List
Type "2"
Sleep 1.5s
Down 2
Sleep 1s
Type "i"
Sleep 2s

# Tab 3: Containers & Live Telemetry
Type "3"
Sleep 2s
Down 1
Sleep 1s
Type "l"
Sleep 2s
Type "q"
Sleep 1s

# Tab 4: Compose Projects
Type "4"
Sleep 2s

# Tab 5: Volumes
Type "5"
Sleep 1.5s

# Tab 6: Networks
Type "6"
Sleep 1.5s

# Tab 7: System & Smart Cleanup
Type "7"
Sleep 2s
Type "c"
Sleep 2s
Type "q"
Sleep 1s

# Command Palette
Type ":"
Sleep 1s
Type "nginx"
Sleep 1.5s
Escape
Sleep 1s

Type "q"
Sleep 1s
